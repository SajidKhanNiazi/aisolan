# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://bookzello.com

# Supabase - browser-safe project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server integrations
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# Transactional Email (Resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Bookzello <bookings@bookzello.com>

# Google Calendar OAuth & Sync
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# GOOGLE_CALENDAR_REDIRECT_URI=https://bookzello.com/api/integrations/google-calendar/callback

# AI Receptionist (Phase 1H-A & 1H-B)
# AI_RECEPTIONIST_MODE=disabled # mock | openai | disabled
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# AI_BOOKING_WRITES_ENABLED=false # false (default) | true (enables live transactional booking creation via AI)
# AI_DRAFT_SECRET= # Dedicated cryptographically random secret (>= 32 bytes) for draft signing
# AI_BOOKING_ALLOWED_SALONS=bookpilot-qa-salon # Comma-separated salon slugs permitted for transactional AI booking writes

# WhatsApp Cloud API (Phase 1H-D1 Pilot)
# WHATSAPP_ENABLED=false # Master toggle for WhatsApp integration
# WHATSAPP_OUTBOUND_ENABLED=false # When false, uses safe Mock client transport (no live network calls)
# WHATSAPP_BOOKING_WRITES_ENABLED=false # When false, WhatsApp drafts stop at summary (read-only pilot)
# WHATSAPP_PILOT_ALLOWED_SALONS=bookpilot-qa-salon # Comma-separated salon slugs permitted for WhatsApp
# WHATSAPP_GRAPH_API_VERSION=v26.0 # Meta Graph API version (v26.0 current in October 2026; v21.0 sunsets Jan 2027)
# WHATSAPP_APP_ID= # Meta Developer App ID
# WHATSAPP_APP_SECRET= # Meta Developer App Secret (used for X-Hub-Signature-256 validation)
# WHATSAPP_VERIFY_TOKEN= # Secret verify token configured in Meta App Webhook dashboard
# WHATSAPP_TEST_PHONE_NUMBER_ID= # Meta Test Phone Number ID from WhatsApp Getting Started
# WHATSAPP_TEST_WABA_ID= # WhatsApp Business Account ID from Meta App Dashboard
# WHATSAPP_ACCESS_TOKEN= # Meta System User or Test Token with whatsapp_business_messaging permissions
# WHATSAPP_AUTHORIZED_TEST_RECIPIENTS= # Comma-separated E.164 phone numbers (e.g. 447700900000) allowed in test pilot
# WHATSAPP_EXECUTION_MODE=async_trigger # async_trigger (default) | inline (synchronous debugging)

# Upstash QStash (Real-Time Asynchronous Serverless Worker Trigger)
# QSTASH_TOKEN= # REST API Bearer token from console.upstash.com
# QSTASH_CURRENT_SIGNING_KEY= # Current signing key for verifying Upstash-Signature headers
# QSTASH_NEXT_SIGNING_KEY= # Next signing key for zero-downtime key rotation



