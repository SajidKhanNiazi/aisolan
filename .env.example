# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: NEXT_PUBLIC_APP_URL=https://bookzello.com

# Supabase - browser-safe project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server integrations
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# Transactional Email (Resend)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Bookzello <bookings@bookzello.com>

# Google Calendar OAuth & Sync
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# GOOGLE_CALENDAR_REDIRECT_URI=https://bookzello.com/api/integrations/google-calendar/callback

# AI Receptionist (Phase 1H-A & 1H-B)
# AI_RECEPTIONIST_MODE=disabled # mock | openai | disabled
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# AI_BOOKING_WRITES_ENABLED=false # false (default) | true (enables live transactional booking creation via AI)
# AI_DRAFT_SECRET= # Dedicated cryptographically random secret (>= 32 bytes) for draft signing
# AI_BOOKING_ALLOWED_SALONS=bookpilot-qa-salon # Comma-separated salon slugs permitted for transactional AI booking writes


